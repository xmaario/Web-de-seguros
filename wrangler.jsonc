// Cloudflare Workers config: serves this folder as a static site.
// Only /api/* runs the Worker code in src/worker.js (contact form).
{
  "name": "unpackinsurance",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_TO": "unpackinsurance@gmail.com"
  },
  // Contact form emails go only to this verified Email Routing destination (free on all plans).
  // Enabled once Email Routing is active and the Gmail destination is verified:
  // "send_email": [
  //   { "name": "EMAIL", "destination_address": "unpackinsurance@gmail.com" }
  // ],
  // Max 5 messages per minute from the same IP.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
